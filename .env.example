# ==========================================================
# Configurações do Assistente de Voz
# ==========================================================

# Nome do assistente para detecção de Wakeword (ex: Valéria, MarIA)
# O sistema aceita variações com saudações (ex: "Oi Valéria", "Ok Valéria", "Valeria")
ASSISTANT_NAME=Valéria

# Provedores de serviços
LLM_PROVIDER=openai
TTS_PROVIDER=edge-tts
STT_PROVIDER=openai

# Chave de API da OpenAI (necessária para LLM e Whisper STT)
OPENAI_API_KEY=sua_chave_openai_aqui
